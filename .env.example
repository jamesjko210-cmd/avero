# Jarvis V4 compatibility environment template.
# V3-named variables and storage paths remain the tested runtime interfaces for this release.
# Copy this to .env and fill values locally. Never commit real secrets.

# Storage and notes
JARVIS_V3_ENV=
JARVIS_DATA_DIR=~/.jarvis_v3
JARVIS_DB_PATH=~/.jarvis_v3/jarvis.sqlite
JARVIS_STORAGE_FALLBACK_DIR=.jarvis_v3_runtime
JARVIS_DISABLE_STORAGE_FALLBACK=0
JARVIS_OBSIDIAN_VAULT=
OBSIDIAN_VAULT_PATH=
JARVIS_OBSIDIAN_ROOT=Jarvis

# Model routing. Ollama remains the local default.
JARVIS_MODEL_PROVIDER=ollama
# Ollama is loopback-only. Keep this on a numeric loopback address; localhost is
# accepted but pinned to 127.0.0.1 before use. Invalid or non-loopback values block
# Ollama calls and probes instead of falling back to another destination.
OLLAMA_HOST=127.0.0.1:11434
# Also configure the Ollama daemon with OLLAMA_NO_CLOUD=1 and restart it when
# on-device-only model execution is intended. This value records operator intent;
# Jarvis cannot attest the daemon configuration or where model execution occurs.
OLLAMA_NO_CLOUD=1
# Stored personal context is eligible for Ollama only when OLLAMA_NO_CLOUD=1 and
# this separate consent flag are both 1 (and the route/model checks also pass).
# Keep the default at 0 unless you accept that daemon execution remains unverified.
JARVIS_ALLOW_UNVERIFIED_OLLAMA_PERSONAL_CONTEXT=0
OLLAMA_MODEL=llama3.1
# Leave these blank to inherit the selected provider's defaults. Set explicit
# aliases only when intentionally overriding Ollama or OpenAI routing.
JARVIS_CHAT_MODEL=
JARVIS_PLANNER_MODEL=
JARVIS_CHAT_REASONING_EFFORT=medium
JARVIS_PLANNER_REASONING_EFFORT=low
JARVIS_MODEL_TIMEOUT_SECONDS=2.5
JARVIS_CHAT_TIMEOUT_SECONDS=20
JARVIS_USE_MODEL_PLANNER=1

# Optional OpenAI Responses API provider. Keep the key local and never commit it.
# Set provider=openai, then choose gpt-5.6, gpt-5.6-terra, or gpt-5.6-luna above.
# For routine Jarvis turns, set JARVIS_CHAT_REASONING_EFFORT=low above. The OpenAI ceiling includes hidden
# reasoning, visible output, and formatting; 25000 follows OpenAI's initial
# experimentation guidance and is a maximum, not expected usage. Lower it only
# after measuring successful real requests because a small ceiling can expire
# during reasoning before GPT-5.6 produces visible text.
JARVIS_OPENAI_MAX_OUTPUT_TOKENS=25000
# Jarvis sends store=false, but that is not a zero-retention guarantee. OpenAI's
# default abuse-monitoring logs may retain prompts/responses for up to 30 days
# unless the API project has approved retention controls. Check the project policy
# before sending sensitive personal content.
# Every OpenAI request also carries a stable "jarvis-v3-single-owner" safety
# pseudonym. It is not derived from your name, email, messaging IDs, local username,
# or API key. Jarvis is currently a single-owner application; a future multi-user
# mode must replace this with a distinct privacy-preserving identifier per user.
OPENAI_API_KEY=
# Ordinary OpenAI chat still sends the current message explicitly typed for that
# turn. Stored profile, preferences, memory, skills, and prior conversation
# history stay local by default. Set to 1 only to opt in to sending those stored
# personal-context sources to the configured OpenAI model.
JARVIS_ALLOW_REMOTE_PERSONAL_CONTEXT=0
# Scheduled conversation compaction sends old history only through a personal-
# context-eligible Ollama route by default. Set to 1 only to approve old
# conversation batches for another configured model route, including OpenAI or
# an Ollama loopback route whose daemon execution locality is not verified.
JARVIS_ALLOW_REMOTE_COMPACTION=0

# Local verification
JARVIS_SMOKE_MODULE_TIMEOUT_SECONDS=180
# V3 daemons are opt-in so tests and local development cannot claim V2 services. The startup
# guard reads this from the process environment before loading `.env`; LaunchAgent templates stay
# disabled until a supervised cutover explicitly adds the variable to their environment.
JARVIS_V3_ENABLE_DAEMONS=0
# Scheduler execution has a second, service-specific gate. Enabling Telegram or iMessage must not
# activate due jobs. Add this separately to the process environment only for a supervised scheduler
# cutover after reviewing every enabled job and delivery target.
JARVIS_V3_ENABLE_SCHEDULER=0

# Optional local voice transcription models. Use local paths only; Jarvis does not download models.
JARVIS_VOICE_WHISPER_MODEL_PATH=
JARVIS_VOICE_FASTER_WHISPER_MODEL_PATH=

# Optional local OAV screenshot reviewer command. Use a local executable only; Jarvis does not download models.
JARVIS_OAV_VISION_REVIEWER_COMMAND=

# Telegram command channel
TELEGRAM_BOT_TOKEN=
JARVIS_OWNER_TELEGRAM=
JARVIS_TELEGRAM_STATE=~/.jarvis_v3/telegram_control.json

# Gmail connector
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Legacy/dev-only iMessage command channel
JARVIS_OWNER_IMESSAGE=
JARVIS_V3_IMESSAGE_STATE=~/.jarvis_v3/imessage_control.json

# Google connectors
JARVIS_GOOGLE_CREDS=~/.jarvis_v3/google_credentials.json
# Least-privilege token used only by Calendar reads.
JARVIS_GOOGLE_READONLY_TOKEN=~/.jarvis_v3/google_calendar_readonly_token.json
# Optional full-access token used only by approval-gated Calendar mutations.
JARVIS_GOOGLE_TOKEN=~/.jarvis_v3/google_token.json

# Local-safe public lookup defaults
JARVIS_WEATHER_LOCATION=
JARVIS_NEWS_LOCALE=en-US:US

# Local status dashboard
JARVIS_STATUS_HOST=127.0.0.1
JARVIS_STATUS_PORT=8766
# Required to start the dashboard. Use a unique random printable secret (32-256 characters).
# The real .env must be a non-symlink, owner-only file: chmod 600 .env
JARVIS_STATUS_AUTH_TOKEN=

# Optional context ingestion
JARVIS_WATCHED_DIRS=

# Telegram reminders
JARVIS_REMINDERS_FILE=~/.jarvis_v3/telegram_reminders.json
